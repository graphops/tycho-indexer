ARG BASE_IMAGE=localhost/tycho-indexer:upstream-latest

FROM rust:1.91-bookworm AS migration-helper-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
RUN cargo build --release -p migration-runner
FROM ${BASE_IMAGE}
LABEL org.opencontainers.image.title="tycho-indexer (GraphOps)"
LABEL org.opencontainers.image.description="GraphOps packaged tycho-indexer image with embedded migration helper"
WORKDIR /opt/tycho-indexer

COPY substreams substreams
COPY --from=migration-helper-builder /workspace/target/release/migration-runner /usr/local/bin/tycho-migration-runner

ENTRYPOINT [ "/opt/tycho-indexer/tycho-indexer"]
